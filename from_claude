#![allow(non_snake_case)]
use std::collections::HashMap;

use crate::components::types::CpuInstruction;

use super::bus::Bus;
use super::types::{AddrModeMneumonic, CpuFlags, M6502AddrModes, M6502Opcodes};
use super::{HIGH_BYTE, LOOKUP_TABLE, LOW_BYTE, TOP_BIT_THRESH};

#[derive(Debug)]
pub struct CPU {
    a: u8,
    x: u8,
    y: u8,
    sp: u8,
    pc: u16,
    status: u8,

    fetched: u8,
    temp: u16,
    abs: u16,
    rel: u16,
    opcode: u8,
    cycles: u8,
    _clock_count: u32,
}

impl CPU {
    #[inline]
    pub const fn new() -> Self {
        Self {
            a: 0x00,
            x: 0x00,
            y: 0x00,
            sp: 0x00,
            pc: 0x0000,
            status: CpuFlags::E as u8,
            fetched: 0x00,
            temp: 0x0000,
            abs: 0x0000,
            rel: 0x0000,
            opcode: 0x00,
            cycles: 0,
            _clock_count: 0,
        }
    }

    #[inline]
    pub fn fetch(&mut self, bus: &Bus) -> u8 {
        let instruction: &CpuInstruction = &LOOKUP_TABLE[self.opcode as usize];
        match instruction.mneumonic.am_name == AddrModeMneumonic::IMP {
            true => (),
            false => {
                self.fetched = bus.read(self.abs, false);
            }
        }
        self.fetched
    }

    /// FIX: clear path was `|= !(f as u8)` which ORs in all bits except f —
    /// i.e. it *sets* almost everything. Must be `&= !(f as u8)` to clear only f.
    #[inline]
    pub fn set_flag(&mut self, f: CpuFlags, conditional_set: bool) {
        if conditional_set {
            self.status |= f as u8;
        } else {
            self.status &= !(f as u8); // FIX: was |=
        }
    }

    /// FIX: `(high << 8) << low` is a double-shift; correct is `(high << 8) | low`.
    pub fn reset(cpu: &mut CPU, bus: &Bus) {
        cpu.abs = 0xFFFC;
        let low: u16 = bus.read(cpu.abs, false) as u16;
        let high: u16 = bus.read(cpu.abs + 1, false) as u16;

        cpu.pc = (high << 8) | low; // FIX: was (high << 8) << low

        cpu.a = 0;
        cpu.x = 0;
        cpu.y = 0;
        cpu.sp = 0xFD;
        cpu.status = 0x00 | CpuFlags::U as u8;

        cpu.rel = 0x0000;
        cpu.abs = 0x0000;
        cpu.fetched = 0x00;

        cpu.cycles = 8;
    }

    pub fn clock(cpu: &mut CPU, bus: &mut Bus) {
        if cpu.complete() {
            cpu.opcode = bus.read(cpu.pc, true);
            cpu.set_flag(CpuFlags::U, true);
            cpu.pc += 1;

            let instruction: &CpuInstruction =
                &LOOKUP_TABLE[cpu.opcode as usize];
            cpu.cycles = instruction.cycles;

            // FIX: addr_mode MUST run first — it sets cpu.abs, which op_code
            // reads via fetch(). Original had these reversed, causing every
            // instruction to fetch from the previous instruction's address.
            let added_cycle2: u8 = (instruction.addr_mode)(cpu, bus);
            let added_cycle1: u8 = (instruction.op_code)(cpu, bus);

            cpu.cycles += added_cycle1 & added_cycle2;
            cpu.set_flag(CpuFlags::U, true);
        }
        cpu._clock_count += 1;
        cpu.cycles -= 1;
    }

    #[inline(always)]
    pub const fn get_flag(&self, f: CpuFlags) -> u8 {
        (self.status & f as u8 > 0) as u8
    }

    #[inline(always)]
    pub const fn complete(&self) -> bool {
        self.cycles == 0
    }

    pub fn disassemble(
        bus: &mut Bus,
        start: u16,
        stop: u16,
    ) -> HashMap<u16, String> {
        let mut address: u32 = start.into();
        let mut _value: u8;
        let mut low: u8 = 0;
        let mut _high: u8;
        let mut line_address: u16;

        let mut lined_maps: HashMap<u16, String> =
            HashMap::<u16, String>::new();

        while address <= stop as u32 {
            line_address = address as u16;

            let mut instruction_address: String =
                format!("${:04x}: ", address);

            let opcode: u8 = bus.read(address as u16, true);
            let instruction: &CpuInstruction = &LOOKUP_TABLE[opcode as usize];

            address += 1;
            instruction_address
                .push_str(format!("{} ", instruction.mneumonic.name).as_str());

            match instruction.mneumonic.am_name {
                AddrModeMneumonic::IMP => {
                    instruction_address.push_str("{IMP}");
                }
                AddrModeMneumonic::IMM => {
                    _value = bus.read(address as u16, true);
                    address += 1;
                    _high = 0x00;
                    instruction_address
                        .push_str(&format!("#${:02x} {{IMM}}", _value));
                }
                AddrModeMneumonic::ZP0 => {
                    low = bus.read(address as u16, true);
                    address += 1;
                    _high = 0x00;
                    instruction_address
                        .push_str(&format!("${:02x} {{ZP0}}", low));
                }
                AddrModeMneumonic::ZPX => {
                    low = bus.read(address as u16, true);
                    address += 1;
                    _high = 0x00;
                    instruction_address
                        .push_str(&format!("${:02x},X {{ZPX}}", low));
                }
                AddrModeMneumonic::ZPY => {
                    low = bus.read(address as u16, true);
                    address += 1;
                    _high = 0x00;
                    instruction_address
                        .push_str(&format!("${:02x},Y {{ZPY}}", low));
                }
                AddrModeMneumonic::IZX => {
                    low = bus.read(address as u16, true);
                    address += 1;
                    _high = 0x00;
                    instruction_address
                        .push_str(&format!("(${:02x},X) {{IZX}}", low));
                }
                AddrModeMneumonic::IZY => {
                    low = bus.read(address as u16, true);
                    address += 1;
                    _high = 0x00;
                    instruction_address
                        .push_str(&format!("(${:02x}),Y {{IZY}}", low));
                }
                AddrModeMneumonic::ABS => {
                    low = bus.read(address as u16, false);
                    address += 1;
                    _high = bus.read(address as u16, false);
                    address += 1;
                    instruction_address.push_str(&format!(
                        "${:04x} {{ABS}}",
                        ((_high as u32) << 8) | low as u32
                    ));
                }
                AddrModeMneumonic::ABX => {
                    low = bus.read(address as u16, false);
                    address += 1;
                    _high = bus.read(address as u16, false);
                    address += 1;
                    instruction_address.push_str(&format!(
                        "${:04x},X {{ABX}}",
                        ((_high as u32) << 8) | low as u32
                    ));
                }
                AddrModeMneumonic::ABY => {
                    low = bus.read(address as u16, false);
                    address += 1;
                    _high = bus.read(address as u16, false);
                    address += 1;
                    instruction_address.push_str(&format!(
                        "${:04x},Y {{ABY}}",
                        ((_high as u32) << 8) | low as u32
                    ));
                }
                AddrModeMneumonic::IND => {
                    low = bus.read(address as u16, false);
                    address += 1;
                    _high = bus.read(address as u16, false);
                    address += 1;
                    instruction_address.push_str(&format!(
                        "(${:04x}) {{IND}}",
                        ((_high as u32) << 8) | low as u32
                    ));
                }
                AddrModeMneumonic::REL => {
                    _value = bus.read(address as u16, false);
                    address += 1;
                    instruction_address.push_str(&format!(
                        "${:02x} [${}] {{REL}}",
                        _value,
                        (address as i32)
                            + (_value as i8 as i32)
                    ));
                }
            }
            lined_maps.insert(line_address, instruction_address.clone());
        }

        lined_maps
    }

    // ── Accessors ─────────────────────────────────────────────────────────────

    pub const fn a(&self) -> u8 { self.a }
    pub const fn x(&self) -> u8 { self.x }
    pub const fn y(&self) -> u8 { self.y }
    pub const fn sp(&self) -> u8 { self.sp }
    pub const fn pc(&self) -> u16 { self.pc }
    pub const fn status(&self) -> u8 { self.status }
    pub const fn fetched(&self) -> u8 { self.fetched }
    pub const fn temp(&self) -> u16 { self.temp }
    pub const fn abs(&self) -> u16 { self.abs }
    pub const fn rel(&self) -> u16 { self.rel }
    pub const fn opcode(&self) -> u8 { self.opcode }
    pub const fn cycles(&self) -> u8 { self.cycles }
    pub const fn clock_count(&self) -> u32 { self._clock_count }

    #[cfg(feature = "debug")]
    pub fn set_a(&mut self, a: u8) { self.a = a; }
    #[cfg(feature = "debug")]
    pub fn set_x(&mut self, x: u8) { self.x = x; }
    #[cfg(feature = "debug")]
    pub fn set_y(&mut self, y: u8) { self.y = y; }
    #[cfg(feature = "debug")]
    pub fn set_sp(&mut self, sp: u8) { self.sp = sp; }
    #[cfg(feature = "debug")]
    pub fn set_pc(&mut self, pc: u16) { self.pc = pc; }
    #[cfg(feature = "debug")]
    pub fn set_status(&mut self, status: u8) { self.status = status; }
    #[cfg(feature = "debug")]
    pub fn set_fetched(&mut self, fetched: u8) { self.fetched = fetched; }
    #[cfg(feature = "debug")]
    pub fn set_temp(&mut self, temp: u16) { self.temp = temp; }
    #[cfg(feature = "debug")]
    pub fn set_abs(&mut self, abs: u16) { self.abs = abs; }
    #[cfg(feature = "debug")]
    pub fn set_rel(&mut self, rel: u16) { self.rel = rel; }
    #[cfg(feature = "debug")]
    pub fn set_opcode(&mut self, opcode: u8) { self.opcode = opcode; }
    #[cfg(feature = "debug")]
    pub fn set_cycles(&mut self, cycles: u8) { self.cycles = cycles; }
    #[cfg(feature = "debug")]
    pub fn set_clock_count(&mut self, clock_count: u32) {
        self._clock_count = clock_count;
    }
}

impl M6502Opcodes for CPU {
    /// FIX: original did `cpu.a + cpu.fetch(bus)` in u8 — overflows in debug builds.
    /// Must promote to u16 before adding so the carry bit is captured in bit 8.
    fn ADC(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        let fetched = cpu.fetch(bus) as u16;
        cpu.temp =
            cpu.a as u16 + fetched + cpu.get_flag(CpuFlags::C) as u16;

        cpu.set_flag(CpuFlags::C, cpu.temp > 255);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0);
        cpu.set_flag(
            CpuFlags::V,
            !(cpu.a as u16 ^ fetched)
                & (cpu.a as u16 ^ cpu.temp)
                & 0x0080
                != 0,
        );
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0);
        cpu.a = (cpu.temp & LOW_BYTE) as u8;
        1u8
    }

    fn AND(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.a &= cpu.fetch(bus);
        cpu.set_flag(CpuFlags::Z, cpu.a == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.a & TOP_BIT_THRESH as u8) != 0);
        1u8
    }

    #[inline]
    fn ASL(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.temp = (cpu.fetch(bus) as u16) << 1;
        cpu.set_flag(CpuFlags::C, (cpu.temp & HIGH_BYTE) > 0);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0);
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0);
        if LOOKUP_TABLE[cpu.opcode as usize].addr_mode as usize
            == CPU::IMP as usize
        {
            cpu.a = (cpu.temp & LOW_BYTE) as u8;
        } else {
            bus.write(cpu.abs, (cpu.temp & LOW_BYTE) as u8);
        }
        0u8
    }

    #[inline]
    fn BCC(cpu: &mut CPU, _: &mut Bus) -> u8 {
        if cpu.get_flag(CpuFlags::C) == 0_u8 {
            cpu.cycles += 1_u8;
            cpu.abs = cpu.pc.wrapping_add(cpu.rel);
            if cpu.abs & HIGH_BYTE != cpu.pc & HIGH_BYTE {
                cpu.cycles += 1_u8;
            }
            cpu.pc = cpu.abs;
        }
        0_u8
    }

    #[inline]
    fn BCS(cpu: &mut CPU, _: &mut Bus) -> u8 {
        if cpu.get_flag(CpuFlags::C) == 1_u8 {
            cpu.cycles += 1_u8;
            cpu.abs = cpu.pc.wrapping_add(cpu.rel);
            if cpu.abs & HIGH_BYTE != cpu.pc & HIGH_BYTE {
                cpu.cycles += 1_u8;
            }
            cpu.pc = cpu.abs;
        }
        0_u8 // original returned 1 — BCS docs say 0 extra cycles from the op itself
    }

    #[inline]
    fn BEQ(cpu: &mut CPU, _: &mut Bus) -> u8 {
        if cpu.get_flag(CpuFlags::Z) == 1_u8 {
            cpu.cycles += 1_u8;
            cpu.abs = cpu.pc.wrapping_add(cpu.rel);
            if cpu.abs & HIGH_BYTE != cpu.pc & HIGH_BYTE {
                cpu.cycles += 1_u8;
            }
            cpu.pc = cpu.abs;
        }
        0_u8
    }

    #[inline]
    fn BIT(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.temp = (cpu.a & cpu.fetch(bus)) as u16;
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.fetched & (1 << 7)) != 0);
        cpu.set_flag(CpuFlags::V, (cpu.fetched & (1 << 6)) != 0);
        0_u8
    }

    #[inline]
    fn BMI(cpu: &mut CPU, _: &mut Bus) -> u8 {
        if cpu.get_flag(CpuFlags::N) == 1_u8 {
            cpu.cycles += 1_u8;
            cpu.abs = cpu.pc.wrapping_add(cpu.rel);
            if cpu.abs & HIGH_BYTE != cpu.pc & HIGH_BYTE {
                cpu.cycles += 1_u8;
            }
            cpu.pc = cpu.abs;
        }
        0_u8
    }

    #[inline]
    fn BNE(cpu: &mut CPU, _: &mut Bus) -> u8 {
        if cpu.get_flag(CpuFlags::Z) == 0_u8 {
            cpu.cycles += 1_u8;
            cpu.abs = cpu.pc.wrapping_add(cpu.rel);
            if cpu.abs & HIGH_BYTE != cpu.pc & HIGH_BYTE {
                cpu.cycles += 1_u8;
            }
            cpu.pc = cpu.abs;
        }
        0_u8
    }

    #[inline]
    fn BPL(cpu: &mut CPU, _: &mut Bus) -> u8 {
        if cpu.get_flag(CpuFlags::N) == 0 {
            cpu.cycles += 1;
            cpu.abs = cpu.pc.wrapping_add(cpu.rel);
            if cpu.abs & HIGH_BYTE != cpu.pc & HIGH_BYTE {
                cpu.cycles += 1;
            }
            cpu.pc = cpu.abs;
        }
        0x0u8
    }

    /// FIX: original used boolean `|` to construct the PC from two bus reads,
    /// which only produces 0 or 1. Must read lo/hi bytes and assemble properly.
    #[inline]
    fn BRK(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.pc += 1;

        cpu.set_flag(CpuFlags::I, true);
        bus.write(
            0x0100_u16 + cpu.sp as u16,
            (cpu.pc >> 8) as u8,
        );
        cpu.sp -= 1;
        bus.write(
            0x0100_u16 + cpu.sp as u16,
            (cpu.pc & LOW_BYTE) as u8,
        );
        cpu.sp -= 1;

        cpu.set_flag(CpuFlags::B, true);
        bus.write(0x0100_u16 + cpu.sp as u16, cpu.status);
        cpu.sp -= 1;
        cpu.set_flag(CpuFlags::B, false);

        // FIX: was `((read != 0) | (read != 0)).into()` — nonsense
        let lo = bus.read(0xFFFE, false) as u16;
        let hi = bus.read(0xFFFF, false) as u16;
        cpu.pc = (hi << 8) | lo;
        0x0u8
    }

    #[inline]
    fn BVC(cpu: &mut CPU, _: &mut Bus) -> u8 {
        if cpu.get_flag(CpuFlags::V) == 0u8 {
            cpu.cycles += 1;
            cpu.abs = cpu.pc.wrapping_add(cpu.rel);
            if cpu.abs & HIGH_BYTE != cpu.pc & HIGH_BYTE {
                cpu.cycles += 1;
            }
            cpu.pc = cpu.abs;
        }
        0x0u8
    }

    #[inline]
    fn BVS(cpu: &mut CPU, _: &mut Bus) -> u8 {
        if cpu.get_flag(CpuFlags::V) == 1u8 {
            cpu.cycles += 1;
            cpu.abs = cpu.pc.wrapping_add(cpu.rel);
            if cpu.abs & HIGH_BYTE != cpu.pc & HIGH_BYTE {
                cpu.cycles += 1;
            }
            cpu.pc = cpu.abs;
        }
        0x0u8
    }

    #[inline]
    fn CLC(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.set_flag(CpuFlags::C, false);
        0x0u8
    }

    #[inline]
    fn CLD(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.set_flag(CpuFlags::D, false);
        0u8
    }

    #[inline]
    fn CLI(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.set_flag(CpuFlags::I, false);
        0u8
    }

    #[inline]
    fn CLV(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.set_flag(CpuFlags::V, false);
        0u8
    }

    /// FIX: original used `cpu.a - cpu.fetch(bus)` in u8, which panics on
    /// underflow in debug. Use wrapping_sub via u16 widening instead.
    #[inline]
    fn CMP(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        let fetched = cpu.fetch(bus);
        cpu.temp = (cpu.a as u16).wrapping_sub(fetched as u16);
        cpu.set_flag(CpuFlags::C, cpu.a >= fetched);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0x0000);
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0x0000);
        1u8
    }

    #[inline]
    fn CPX(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        let fetched = cpu.fetch(bus);
        cpu.temp = (cpu.x as u16).wrapping_sub(fetched as u16);
        cpu.set_flag(CpuFlags::C, cpu.x >= fetched);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0x0000);
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0x0000);
        0u8
    }

    #[inline]
    fn CPY(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        let fetched = cpu.fetch(bus);
        cpu.temp = (cpu.y as u16).wrapping_sub(fetched as u16);
        cpu.set_flag(CpuFlags::C, cpu.y >= fetched);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0x0000);
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0x0000);
        0u8
    }

    #[inline]
    fn DEC(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.temp = (cpu.fetch(bus) as u16).wrapping_sub(1);
        bus.write(cpu.abs, (cpu.temp & LOW_BYTE) as u8);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0x0000);
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0x0000);
        0u8
    }

    #[inline]
    fn DEX(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.x = cpu.x.wrapping_sub(1);
        cpu.set_flag(CpuFlags::Z, cpu.x == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.x & TOP_BIT_THRESH as u8) != 0);
        0u8
    }

    #[inline]
    fn DEY(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.y = cpu.y.wrapping_sub(1);
        cpu.set_flag(CpuFlags::Z, cpu.y == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.y & TOP_BIT_THRESH as u8) != 0);
        0u8
    }

    /// FIX: original set Z/N flags from `cpu.y` instead of `cpu.a`.
    #[inline]
    fn EOR(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.a ^= cpu.fetch(bus);
        cpu.set_flag(CpuFlags::Z, cpu.a == 0x00); // FIX: was cpu.y
        cpu.set_flag(CpuFlags::N, (cpu.a & TOP_BIT_THRESH as u8) != 0); // FIX: was cpu.y
        1u8
    }

    #[inline]
    fn INC(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.temp = (cpu.fetch(bus) as u16).wrapping_add(1);
        bus.write(cpu.abs, (cpu.temp & LOW_BYTE) as u8);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0x0000);
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0x0000);
        0u8
    }

    #[inline]
    fn INX(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.x = cpu.x.wrapping_add(1);
        cpu.set_flag(CpuFlags::Z, cpu.x == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.x & TOP_BIT_THRESH as u8) != 0);
        0u8
    }

    #[inline]
    fn INY(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.y = cpu.y.wrapping_add(1);
        cpu.set_flag(CpuFlags::Z, cpu.y == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.y & TOP_BIT_THRESH as u8) != 0);
        0u8
    }

    #[inline]
    fn JMP(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.pc = cpu.abs;
        0u8
    }

    /// FIX: high byte push used `cpu.pc << 8` (left shift) instead of
    /// `cpu.pc >> 8` (right shift to get the high byte).
    #[inline]
    fn JSR(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.pc -= 1;

        bus.write(
            0x0100 + cpu.sp as u16,
            (cpu.pc >> 8 & LOW_BYTE) as u8, // FIX: was cpu.pc << 8
        );
        cpu.sp -= 1;
        bus.write(0x0100 + cpu.sp as u16, (cpu.pc & LOW_BYTE) as u8);
        cpu.sp -= 1;

        cpu.pc = cpu.abs;
        0u8
    }

    #[inline]
    fn LDA(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.a = cpu.fetch(bus);
        cpu.set_flag(CpuFlags::Z, cpu.a == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.a & TOP_BIT_THRESH as u8) != 0);
        1u8
    }

    #[inline]
    fn LDX(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.x = cpu.fetch(bus);
        cpu.set_flag(CpuFlags::Z, cpu.x == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.x & TOP_BIT_THRESH as u8) != 0);
        1u8
    }

    #[inline]
    fn LDY(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.y = cpu.fetch(bus);
        cpu.set_flag(CpuFlags::Z, cpu.y == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.y & TOP_BIT_THRESH as u8) != 0);
        1u8
    }

    #[inline]
    fn LSR(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.temp = (cpu.fetch(bus) as u16) >> 1;
        cpu.set_flag(CpuFlags::C, (cpu.fetched & 0x0001) != 0x0000);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0x0000);
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0x0000);
        if LOOKUP_TABLE[cpu.opcode as usize].addr_mode as usize
            == CPU::IMP as usize
        {
            cpu.a = (cpu.temp & LOW_BYTE) as u8;
        } else {
            bus.write(cpu.abs, (cpu.temp & LOW_BYTE) as u8);
        }
        0u8
    }

    #[inline]
    fn NOP(cpu: &mut CPU, _: &mut Bus) -> u8 {
        match cpu.opcode {
            0x1C | 0x3C | 0x5C | 0x7C | 0xDC | 0xFC => 1u8,
            _ => 0u8,
        }
    }

    #[inline]
    fn ORA(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.a |= cpu.fetch(bus);
        cpu.set_flag(CpuFlags::Z, cpu.a == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.a & TOP_BIT_THRESH as u8) != 0);
        1u8
    }

    #[inline]
    fn PHA(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        bus.write(0x0100 + cpu.sp as u16, cpu.a);
        cpu.sp -= 1;
        0u8
    }

    #[inline]
    fn PHP(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        bus.write(
            0x0100 + cpu.sp as u16,
            cpu.status | CpuFlags::B as u8 | CpuFlags::U as u8,
        );
        cpu.set_flag(CpuFlags::B, false);
        cpu.set_flag(CpuFlags::U, false);
        cpu.sp -= 1;
        0u8
    }

    /// FIX: original stored the popped byte into `cpu.status` instead of `cpu.a`.
    /// PLA = Pull Accumulator, not Pull Status.
    #[inline]
    fn PLA(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.sp += 1;
        cpu.a = bus.read(0x0100 + cpu.sp as u16, false); // FIX: was cpu.status
        cpu.set_flag(CpuFlags::Z, cpu.a == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.a & TOP_BIT_THRESH as u8) != 0);
        0u8
    }

    #[inline]
    fn PLP(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.sp += 1;
        cpu.status = bus.read(0x0100 + cpu.sp as u16, false);
        cpu.set_flag(CpuFlags::U, true);
        0u8
    }

    #[inline]
    fn ROL(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.temp =
            ((cpu.fetch(bus) as u16) << 1) | (cpu.get_flag(CpuFlags::C) as u16);
        cpu.set_flag(CpuFlags::C, (cpu.temp & HIGH_BYTE) != 0x0000);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0x0000);
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0x0000);
        if LOOKUP_TABLE[cpu.opcode as usize].addr_mode as usize
            == CPU::IMP as usize
        {
            cpu.a = (cpu.temp & LOW_BYTE) as u8;
        } else {
            bus.write(cpu.abs, (cpu.temp & LOW_BYTE) as u8);
        }
        0u8
    }

    #[inline]
    fn ROR(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.temp = ((cpu.get_flag(CpuFlags::C) as u16) << 7)
            | ((cpu.fetch(bus) as u16) >> 1);
        cpu.set_flag(CpuFlags::C, (cpu.fetched & 0x01) != 0);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0x00);
        if LOOKUP_TABLE[cpu.opcode as usize].addr_mode as usize
            == CPU::IMP as usize
        {
            cpu.a = (cpu.temp & LOW_BYTE) as u8;
        } else {
            bus.write(cpu.abs, (cpu.temp & LOW_BYTE) as u8);
        }
        0u8
    }

    #[inline]
    fn RTI(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.sp += 1;
        cpu.status = bus.read(0x0100 + cpu.sp as u16, false);
        cpu.status &= !(CpuFlags::B as u8);
        cpu.status &= !(CpuFlags::U as u8);

        cpu.sp += 1;
        cpu.pc = bus.read(0x0100 + cpu.sp as u16, false) as u16;
        cpu.sp += 1;
        cpu.pc |= (bus.read(0x0100 + cpu.sp as u16, false) as u16) << 8;
        0u8
    }

    #[inline]
    fn RTS(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.sp += 1;
        cpu.pc = bus.read(0x0100 + cpu.sp as u16, false) as u16;
        cpu.sp += 1;
        cpu.pc |= (bus.read(0x0100 + cpu.sp as u16, false) as u16) << 8;
        cpu.pc += 1;
        0u8
    }

    /// FIX: Z flag checked HIGH_BYTE (always 0 for normal results) — must
    /// check LOW_BYTE. N flag had its condition inverted (`== 0` not `!= 0`).
    #[inline]
    fn SBC(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        // Invert the fetched value so we can add instead of subtract.
        let value: u16 = (cpu.fetch(bus) as u16) ^ LOW_BYTE;
        cpu.temp =
            cpu.a as u16 + value + cpu.get_flag(CpuFlags::C) as u16;
        cpu.set_flag(CpuFlags::C, (cpu.temp & HIGH_BYTE) != 0);
        cpu.set_flag(CpuFlags::Z, (cpu.temp & LOW_BYTE) == 0); // FIX: was HIGH_BYTE
        cpu.set_flag(
            CpuFlags::V,
            (cpu.temp ^ cpu.a as u16) & (cpu.temp ^ value) & TOP_BIT_THRESH
                != 0,
        );
        cpu.set_flag(CpuFlags::N, (cpu.temp & TOP_BIT_THRESH) != 0); // FIX: was == 0
        cpu.a = (cpu.temp & LOW_BYTE) as u8;
        1u8
    }

    #[inline]
    fn SEC(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.set_flag(CpuFlags::C, true);
        0u8
    }

    #[inline]
    fn SED(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.set_flag(CpuFlags::D, true);
        0u8
    }

    #[inline]
    fn SEI(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.set_flag(CpuFlags::I, true);
        0u8
    }

    #[inline]
    fn STA(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        bus.write(cpu.abs, cpu.a);
        0u8
    }

    #[inline]
    fn STX(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        bus.write(cpu.abs, cpu.x);
        0u8
    }

    #[inline]
    fn STY(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        bus.write(cpu.abs, cpu.y);
        0u8
    }

    #[inline]
    fn TAX(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.x = cpu.a;
        cpu.set_flag(CpuFlags::Z, cpu.x == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.x & TOP_BIT_THRESH as u8) != 0);
        0u8
    }

    #[inline]
    fn TAY(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.y = cpu.a;
        cpu.set_flag(CpuFlags::Z, cpu.y == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.y & TOP_BIT_THRESH as u8) != 0);
        0u8
    }

    #[inline]
    fn TSX(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.x = cpu.sp;
        cpu.set_flag(CpuFlags::Z, cpu.x == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.x & TOP_BIT_THRESH as u8) != 0);
        0u8
    }

    #[inline]
    fn TXA(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.a = cpu.x;
        cpu.set_flag(CpuFlags::Z, cpu.a == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.a & TOP_BIT_THRESH as u8) != 0);
        0u8
    }

    #[inline(always)]
    fn TXS(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.sp = cpu.x;
        0u8
    }

    #[inline]
    fn TYA(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.a = cpu.y;
        cpu.set_flag(CpuFlags::Z, cpu.a == 0x00);
        cpu.set_flag(CpuFlags::N, (cpu.a & TOP_BIT_THRESH as u8) != 0);
        0u8
    }

    #[inline(always)]
    fn XXX(_: &mut CPU, _: &mut Bus) -> u8 {
        0u8
    }
}

impl M6502AddrModes for CPU {
    fn IMP(cpu: &mut CPU, _: &mut Bus) -> u8 {
        cpu.fetched = cpu.a;
        0x00
    }

    fn IMM(cpu: &mut CPU, _bus: &mut Bus) -> u8 {
        cpu.abs = cpu.pc;
        cpu.pc += 1;
        0x00
    }

    fn ZP0(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.abs = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;
        cpu.abs &= LOW_BYTE;
        0x00
    }

    /// FIX: original read from `bus[PC + X]` — wrong addressing.
    /// Correct: read the zero-page base from `bus[PC]`, then add X with wrap.
    fn ZPX(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.abs = bus.read(cpu.pc, false).wrapping_add(cpu.x) as u16; // FIX
        cpu.pc += 1;
        cpu.abs &= LOW_BYTE;
        0x00
    }

    /// FIX: same as ZPX but with Y register.
    fn ZPY(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.abs = bus.read(cpu.pc, false).wrapping_add(cpu.y) as u16; // FIX
        cpu.pc += 1;
        cpu.abs &= LOW_BYTE;
        0x00
    }

    fn ABS(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        let lo = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;
        let hi = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;
        cpu.abs = (hi << 8) | lo;
        0x00
    }

    /// FIX: page-cross check compared against LOW_BYTE instead of HIGH_BYTE.
    fn ABX(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        let lo = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;
        let hi = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;
        let base = (hi << 8) | lo;
        cpu.abs = base.wrapping_add(cpu.x as u16);
        // Extra cycle if we crossed a page boundary
        if (cpu.abs & HIGH_BYTE) != (base & HIGH_BYTE) { 1 } else { 0 } // FIX
    }

    /// FIX: same page-cross fix as ABX but with Y.
    fn ABY(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        let lo = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;
        let hi = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;
        let base = (hi << 8) | lo;
        cpu.abs = base.wrapping_add(cpu.y as u16);
        if (cpu.abs & HIGH_BYTE) != (base & HIGH_BYTE) { 1 } else { 0 } // FIX
    }

    /// FIX: sign extension checked bit 3 (0x08) instead of bit 7 (0x80),
    /// and extended into `cpu.abs` instead of `cpu.rel`.
    fn REL(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        cpu.rel = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;
        if (cpu.rel & 0x80) != 0 {   // FIX: was 0x08
            cpu.rel |= 0xFF00;        // FIX: was cpu.abs |= LOW_BYTE
        }
        0x00
    }

    fn IND(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        let ptr_lo = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;
        let ptr_hi = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;

        let ptr: u16 = (ptr_hi << 8) | ptr_lo;

        // Replicate the 6502 page-boundary hardware bug:
        // if the low byte of the pointer is 0xFF the high byte wraps within the page.
        let lo: u16;
        let hi: u16;
        if ptr_lo == 0x00FF {
            lo = bus.read(ptr & 0xFF00, false) as u16;
            hi = bus.read(ptr, false) as u16;
        } else {
            lo = bus.read(ptr + 1, false) as u16;
            hi = bus.read(ptr, false) as u16;
        }
        cpu.abs = (lo << 8) | hi;
        0x00
    }

    /// FIX: original assembly was `(hi<<8 | lo<<8) >> 8` — always discards
    /// the high byte. Correct: `(hi<<8) | lo`.
    fn IZX(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        let t = bus.read(cpu.pc, false);
        cpu.pc += 1;
        let lo = bus.read(t.wrapping_add(cpu.x) as u16 & LOW_BYTE, false) as u16;
        let hi =
            bus.read(t.wrapping_add(cpu.x).wrapping_add(1) as u16 & LOW_BYTE, false)
                as u16;
        cpu.abs = (hi << 8) | lo; // FIX: was ((hi<<8|lo<<8) as u16) >> 8
        0x00
    }

    /// FIX: original added `cpu.y` to the *zero-page lookup address* instead of
    /// to the *16-bit pointer* retrieved from zero page.
    fn IZY(cpu: &mut CPU, bus: &mut Bus) -> u8 {
        let t = bus.read(cpu.pc, false) as u16;
        cpu.pc += 1;
        let lo = bus.read(t & LOW_BYTE, false) as u16;           // FIX: was (t + y) & LO
        let hi = bus.read((t + 1) & LOW_BYTE, false) as u16;     // FIX: was (t + y + 1) & LO
        let base = (hi << 8) | lo;
        cpu.abs = base.wrapping_add(cpu.y as u16);
        if (cpu.abs & HIGH_BYTE) != (base & HIGH_BYTE) { 1 } else { 0 }
    }
}
